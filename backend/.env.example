# Use a Neon pooled connection for application traffic.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_TIMEOUT_SECONDS=10
# Optional direct connection for migrations; falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-DIRECT-NEON-HOST/DBNAME?sslmode=require
MAX_UPLOAD_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Generate distinct random tokens of at least 32 characters. API_KEY grants read/write access.
API_KEY=
READONLY_API_KEY=
API_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Use redis:// for local Redis or rediss:// for TLS-enabled Redis TCP providers such as Upstash.
REDIS_URL=redis://localhost:6379/0
# Compose overrides REDIS_URL with its internal Redis service by default; set this only to change it.
COMPOSE_REDIS_URL=redis://redis:6379/0
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ROUTING_POLICY=static
CHAT_TIMEOUT_SECONDS=20
# Optional OTLP/HTTP collector endpoint; traces are recorded locally when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
CHAT_MAX_ATTEMPTS=2
CHAT_CIRCUIT_FAILURE_THRESHOLD=3
CHAT_CIRCUIT_RESET_SECONDS=30
INGESTION_JOB_MAX_ATTEMPTS=3
EVALUATION_DATASET_DIR=datasets
# Optional estimates; routing reports null when these are not configured.
GROQ_INPUT_COST_PER_1K=
GROQ_OUTPUT_COST_PER_1K=
GROQ_ESTIMATED_LATENCY_MS=
GEMINI_INPUT_COST_PER_1K=
GEMINI_OUTPUT_COST_PER_1K=
GEMINI_ESTIMATED_LATENCY_MS=
# Choose a model available on the free API tier. Pinecone's dimension must match its output.
EMBEDDING_DIMENSION=768
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=incidentiq
